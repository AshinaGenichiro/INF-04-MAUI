<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Zadanie_4.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
			<Entry 
				x:Name="NameEntry"
				Placeholder="Wpisz imie ..."
				/>
			<Entry 
				x:Name="SurnameEntry"
				Placeholder="Wpisz imie ..."
				/>
			<HorizontalStackLayout>
				<Label
					Text="Posiadam Podstawową wiedzę"/>
				<CheckBox
					x:Name="BasicKnowledge"
					/>
			</HorizontalStackLayout>
			<HorizontalStackLayout>
				<Label
					Text="Chce otrzymać certyfikat"
					/>
				<Switch
					x:Name="CertyficateSwitch"
					/>
			</HorizontalStackLayout>
			<Button
				Clicked="OnSingInButtonClicked"
				Text="Zapisz sie"
				/>
			<Label
				x:Name="SummaryLabel"
				/>
			<RadioButton
				Content="Stacjonarny"
				GroupName="TypeOfCourse"
				x:Name="opcjaStacjonarny"
				/>
			<RadioButton
				Content="Online"
				GroupName="TypeOfCourse"
				x:Name="opcjaOnline"
				/>
			<RadioButton
				Content="Hybrydowy"
				GroupName="TypeOfCourse"
				x:Name="opcjaHybrydowy"
				/>
			<Editor
				x:Name="userExpectations"
				Placeholder="Wpisz swoje oczekiwania ..."
				/>
		</VerticalStackLayout>
    </ScrollView>

</ContentPage>
