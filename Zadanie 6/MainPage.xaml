<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Zadanie_6.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
			<Label
				x:Name="ValueLabel"
				FontAttributes="Bold"
				FontSize="23"
				/>
			<Slider
				Minimum="0"
				Maximum="255"
				x:Name="ValueSlider"
				ValueChanged="OnSliderChange"
				/>
			<Label
				x:Name="ResultLabel"
				FontAttributes="Bold"
				FontSize="23"
				/>
		</VerticalStackLayout>
    </ScrollView>

</ContentPage>
