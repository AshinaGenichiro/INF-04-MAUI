<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Zadanie_7.NewPage1"
             Title="NewPage1">
    <VerticalStackLayout>
		<Label
			Text="R:"
			FontSize="24"
			FontAttributes="Bold"
			/>
		<Slider
			x:Name="RedSlider"
			Minimum="0"
			Maximum="255"
			ValueChanged="SliderChanged"
			
			/>
		<Label
			Text="G:"
			FontSize="24"
			FontAttributes="Bold"
			/>
		<Slider
			x:Name="GreenSlider"
			Minimum="0"
			Maximum="255"
			ValueChanged="SliderChanged"
			/>
		<Label
			Text="B:"
			FontSize="24"
			FontAttributes="Bold"
			/>
		<Slider
			x:Name="BlueSlider"
			Minimum="0"
			Maximum="255"
			ValueChanged="SliderChanged"
			/>
		<Label
			x:Name="HexColorLabel"
				FontSize="24"
				FontAttributes="Bold"
			/>

	</VerticalStackLayout>
</ContentPage>