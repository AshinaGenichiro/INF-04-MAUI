<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Zadanie_10.MainPage">

    <ScrollView>
		<VerticalStackLayout
            Padding="30,0"
            Spacing="25">

			<Entry
				x:Name="EntryWpis"
				Placeholder="Napisz cos"
				/>
			<Label
				x:Name="ResultLabel"
				Text="{Binding Source = {x:Reference EntryWpis}, Path=Text}"
				FontSize="20"
				/>
		</VerticalStackLayout>
    </ScrollView>

</ContentPage>
